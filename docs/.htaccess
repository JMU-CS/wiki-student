RewriteEngine On

# Remove trailing /start from any path
RewriteRule ^(.*/)start/?$ /$1 [R=301,L]

# Redirect optional start on root page
Redirect 301 /start /

# Pages moved to faculty side of wiki
Redirect 301 /department/teachinginterests /faculty/teaching/teaching_interests/

# Legacy urls generated by redirects.py
Redirect 301 /student/cs-sucess /student/cs-success/
Redirect 301 /student/utilities/start/keypairs/beginner /student/utilities/beginner/
Redirect 301 /student/utilities/start/keypairs /student/utilities/keypairs/
